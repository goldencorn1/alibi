# Safe macOS defaults. Copy to .env.local; never commit or share a populated copy.
MAX_EXTERNAL_API_COST_USD=0
APP_BASE_URL=http://localhost:3000
ALIBI_DATA_MODE=recorded

# Live Anthropic attribution only; leave empty for recorded.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Base Sepolia/x402 only; leave empty for recorded and unpaid 402 boundary demos.
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_NETWORK=eip155:84532
ALIBI_PAYMENT_ADDRESS=
BASE_SEPOLIA_RPC_URL=

# Optional local database; do not set until the local container is running.
DATABASE_URL=

# Bundled local ONNX model. No EMBEDDING_API_KEY is used.
ALIBI_MODEL_PATH=./models

# Local Hardhat chain only.
LOCAL_CHAIN_RPC_URL=http://127.0.0.1:8545

# Optional already-verified deployment/status values; no transactions are sent by setup.
ALIBI_SUBSCRIPTION_CONTRACT_ADDRESS=
ERC8004_CLIENT_ADDRESS=
ERC8004_AGENT_ID=
